/* Update banner */
#update-banner-wrap {
    display: none;
    dock: bottom;
    layer: overlay;
    width: auto;
    height: 3;
    margin: 0 0 2 2;
    border: round $warning;
}
#update-banner {
    background: $warning 20%;
    color: $text;
    padding: 0 1;
    width: auto;
    height: 1fr;
    content-align: left middle;
}

/* Tables */
DataTable {
    height: 1fr;
}
DataTable:blur > .datatable--cursor {
    color: $text;
}
DataTable:focus > .datatable--cursor {
    background: $accent;
    color: $text;
}
.table-group {
    height: 1fr;
    border: round $accent;
    padding: 0 1;
}
.table-group:can-focus {
    border: round $accent-lighten-2;
}
LoadingIndicator {
    display: none;
}

/* Comments panel */
#comments {
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
    margin: 3 3 3 3;
    background: $surface;
    border: round $accent;
    border-subtitle-align: right;
    padding: 1 2;
}
.review-approval {
    background: $success 20%;
}
.review-changes-requested {
    background: $warning 20%;
}
.review-dismissed {
    background: $surface-darken-1;
}
.comment-body {
    background: $panel;
}
.comment-thread {
    background: $surface-darken-1;
}
CollapsibleTitle:focus {
    background: $accent;
}
.commit {
    background: $primary 20%;
}

/* Help dialog */
HelpScreen {
    align: center middle;
}
#help-dialog {
    grid-size: 1;
    grid-rows: auto 1fr auto;
    grid-gutter: 1;
    padding: 1 2;
    width: 72;
    height: auto;
    max-height: 90%;
    border: thick $background 80%;
    background: $surface;
}
#help-title {
    width: 1fr;
    content-align: center middle;
    padding-bottom: 1;
}
#help-body {
    width: 1fr;
}

/* PR info dialog */
PrInfoScreen {
    align: center middle;
}
#pr-info-dialog {
    grid-size: 1;
    grid-rows: auto 1fr auto;
    grid-gutter: 1;
    padding: 1 2;
    width: 72;
    height: auto;
    max-height: 90%;
    border: thick $background 80%;
    background: $surface;
}
#pr-info-title {
    width: 1fr;
    text-style: bold;
    padding-bottom: 1;
}
#pr-info-body {
    width: 1fr;
}

/* CI warning dialog */
CiWarningScreen {
    align: center middle;
}
#ci-warn-dialog {
    grid-size: 1;
    grid-rows: 1fr 3;
    grid-gutter: 1;
    padding: 0 1;
    width: 60;
    height: 10;
    border: thick $background 80%;
    background: $surface;
}
#ci-warn-question {
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

/* Quit dialog */
QuitScreen {
    align: center middle;
}
#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}
#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}
Button {
    width: 100%;
}